# ---- required ----
# Neon pooled connection string (Settings → Connection Details → Pooled).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Long random string. Rotating it signs everybody out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The first admin account, created automatically on first boot.
ADMIN_EMAIL=you@mejibuilds.com
ADMIN_PASSWORD=change-me-immediately
ADMIN_NAME=Meji Builds

# ---- recommended ----
# Your live URL. Invite + client portal links are built from this.
PUBLIC_BASE_URL=https://your-app.vercel.app

# ---- payments ----
# "manual" (default) works fully: admin records payments received by transfer.
# Switch to "paystack" once your keys are live.
PAYMENT_PROVIDER=manual
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- optional ----
# Without this, invite/portal links are shown on screen and logged instead.
RESEND_API_KEY=
MAIL_FROM=Meji Connect <onboarding@resend.dev>
SUPPORT_EMAIL=hello@mejibuilds.com

# ---- tunable defaults (also editable later from the admin dashboard) ----
DEFAULT_COMMISSION_BPS=1000
HOLD_DAYS=10
MIN_WITHDRAWAL_KOBO=500000
DEPOSIT_BPS=8000
ATTRIBUTION_WINDOW_DAYS=365
